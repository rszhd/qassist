# Staging (US-038) — copy to .env.staging and fill in.
#
# This is the DIFF from production's .env, not a second copy of it. Everything
# not listed here is the same on both, so read this file next to .env.example
# rather than instead of it — but note that compose does not merge env files:
# --env-file replaces, so your real .env.staging must be complete. Start from a
# copy of .env and change exactly what is below.
#
#   docker compose -p qassist-staging -f docker-compose.yml \
#     -f docker-compose.prod.yml --env-file .env.staging up -d
#
# Staging is the same box and the same two compose files as production. The
# project name is what separates them: `-p` gives it its own network, its own db
# container, its own pgdata volume and its own Traefik router. What is left to
# get right is the handful of values that reach the outside world — getting one
# wrong is how a staging environment mails real users or charges real cards.

# --- Where it lives ---
APP_HOST=staging.qassist.run
PUBLIC_BASE_URL=https://staging.qassist.run
# Its own artifact directory: two stacks from one checkout must not write runs
# into the same place.
RUNS_DIR=./runs-staging
# A second public hostname serving the same product is a duplicate-content
# problem and an invitation. Production sets "all".
ROBOTS_TAG=noindex, nofollow
# The tag being promoted. Green here is what earns it production's .env.
QASSIST_IMAGE=ghcr.io/<owner>/qassist:<tag>

# --- Secrets: DISTINCT values, not production's ---
# Not merely different files — different values. A staging session cookie or a
# staging API key must be refused by production, and vice versa, which is only
# true if the secret that signs them differs. Generate each one fresh:
#   openssl rand -hex 32
SESSION_SECRET=
NOTIFY_SECRET=
WORKER_API_TOKEN=
# Its own too, and note the consequence: staging cannot decrypt a BYOK key
# stored on production, which is the point. Staging users re-enter their own.
KEY_ENCRYPTION_SECRET=

# --- Stripe: TEST mode ---
# Test keys, a test price, and the signing secret of staging's OWN webhook
# endpoint (a Stripe endpoint's secret is per-endpoint — reusing production's
# means every event fails signature verification here). This is where US-022's
# live round trip happens: a real Checkout and a real webhook, on test keys,
# without pointing test config at the instance real users are on.
STRIPE_SECRET_KEY=sk_test_…
STRIPE_WEBHOOK_SECRET=whsec_…
STRIPE_PRICE_ID=price_…

# --- Mail: real sends, maintainer-only recipients ---
# MAIL_DEV_CONSOLE is deliberately NOT the answer here. The point of staging is
# to prove the Resend path works end to end, and console-logging a message
# proves nothing. So: send for real, but only ever to yourself — no project on
# staging may carry a stranger's address.
MAIL_DEV_CONSOLE=
NOTIFY_EMAILS=you@example.com
OPERATOR_EMAIL=you@example.com
# The one place a shared value is correct: the sender domain is verified once
# with Resend and both stacks send as it.
# MAIL_FROM=  (same as production)

# --- Capacity ---
# Staging borrows RAM from production on the same box. Fidelity of the deploy is
# the goal, not throughput — if we ever need to prove throughput that is a
# different, temporary box (US-015 territory).
MAX_CONCURRENT_SESSIONS=1

# --- Not staging's job ---
# The demo sandbox is its own deployment concern. Leave AUTH_MODE unset so
# staging is the magic-link app production is, which is what makes it a
# rehearsal of production rather than of something else.
# AUTH_MODE=
AUTH_ENABLED=1
