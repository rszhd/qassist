{
  "manifest_version": 3,
  "name": "QAssist Session Capture",
  "version": "0.1.1",
  "minimum_chrome_version": "102",
  "description": "Send a signed-in browser session for one site you name to your own QAssist instance, for tests that can't drive the login.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QAssist session capture",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["cookies", "scripting", "storage", "identity.email"],
  "optional_host_permissions": ["<all_urls>"]
}
