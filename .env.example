# Copy to .env and fill in. Never commit the real .env.

# Shared secret every API/WS caller must send as `Authorization: Bearer <token>`.
# Optional for local single-user use: leave it blank and no token is required
# (the UI's token box can stay empty). Set one before exposing the port —
# generate with: openssl rand -hex 32
WORKER_API_TOKEN=

# OpenAI drives the browser agent. This is the one value you must supply;
# without it the app starts but refuses to run tests.
OPENAI_API_KEY=sk-...
BROWSER_USE_MODEL=gpt-4.1

# Concurrency cap — the real throttle for this box.
# Rule of thumb: floor((RAM_GB - 1.5) / 1). For 7.6 GB -> 4-5.
MAX_CONCURRENT_SESSIONS=4

# Safety ceiling on agent steps per run.
MAX_STEPS=60

# Port Express listens on (also mapped in docker-compose).
PORT=8080

# Where this instance is reachable from outside, e.g. https://qa.example.com.
# Only used to put a working "View recording" link in the PDF report; the app
# serves the recording either way.
PUBLIC_BASE_URL=

# Every run is recorded to runs/<runId>/recording.mp4. Set to 0 to turn
# recording off (saves ~0.1-0.2 vCPU per session, and unwatched runs then
# skip frame capture entirely).
QA_RECORD=1

# How many days to keep a run's artifacts (runs/<runId>/: the PDF report and
# the mp4 recording, tens of MB per run). After this they are deleted and the
# run is marked in history as having had its artifacts removed — the verdict,
# timings and step count are kept forever either way. Swept at startup and
# every 6 hours. Set to 0 to keep artifacts until the disk fills.
ARTIFACT_RETENTION_DAYS=7

# Postgres control plane (saved tests, suites, run history). You normally
# don't set this: docker compose wires the app to its own db service, and
# `npm run dev` auto-starts that db and defaults to it on localhost:5433.
# Set it only to point at a different Postgres (shell env, not this file —
# the dev script's default wins over .env):
#   DATABASE_URL=postgres://user:pass@host:5432/qassist npm run dev
