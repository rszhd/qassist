# Copy to .env and fill in. Never commit the real .env.

# Shared secret every API/WS caller must send as `Authorization: Bearer <token>`.
# Optional for local single-user use: leave it blank and no token is required
# (the UI's token box can stay empty). Set one before exposing the port —
# generate with: openssl rand -hex 32
WORKER_API_TOKEN=

# There is deliberately no server-wide OpenAI key variable (US-039). Every run
# is funded by the key its caller supplied — paste yours into Settings → OpenAI
# key after first boot (it is stored encrypted; KEY_ENCRYPTION_SECRET below is
# what you must generate). The server holds no key of its own, so a shared
# instance can never spend the operator's tokens on someone else's runs.
BROWSER_USE_MODEL=gpt-4.1

# Encrypts stored OpenAI keys at rest (US-005 BYOK). Required — it is the only
# way to supply a run key besides passing one on every API call. Deliberately
# its own secret, NOT SESSION_SECRET: rotating that to revoke sessions must
# never make every stored key undecryptable. Generate once and keep it:
#   openssl rand -hex 32
KEY_ENCRYPTION_SECRET=

# Concurrency cap — the real throttle for this box.
# Rule of thumb: floor((RAM_GB - 1.5) / 1). For 7.6 GB -> 4-5.
MAX_CONCURRENT_SESSIONS=4

# Per-user fair-use cap (US-028). Unset = off: one global queue, byte-for-byte
# the single-user default. Set it on a SHARED instance (an org's team) so no one
# person can hold all MAX_CONCURRENT_SESSIONS slots and queue everyone else.
# Counts a user's running + queued runs; over it, a run is refused (429), not
# queued. Pick it against MAX_CONCURRENT_SESSIONS: e.g. 2 with a global 4 lets
# two people share the box. Applies to every user including the operator —
# US-058 lets you move one account off this default without moving anyone else:
#   npm --prefix server run concurrency -- them@example.com 4
# MAX_CONCURRENT_PER_USER=2

# Where the agent's browser may navigate (US-042). ON by default: the agent
# runs inside the app container, on the same compose network as `db` and with
# whatever egress this box has, so an instance other people can register on
# must not let "point the tester at a URL" become "read the host's cloud
# metadata endpoint". It blocks IP literals in every spelling (dotted quad,
# IPv6, decimal, hex) and, via QA_DENIED_HOSTS below, the hostnames that are
# not literals at all.
#
# Set it to 0 if your whole use case is testing your own machine —
# http://localhost:3000 is a real and common target, and 0 restores exactly the
# pre-US-042 behaviour. It is one switch on purpose: 0 clears the default
# denylist too, so you are not left unable to reach localhost after setting the
# flag that says you may.
# QA_BLOCK_PRIVATE_NETWORKS=0
#
# Hostnames refused by name, comma separated. Defaults to the list below while
# the floor is up. Not redundant with the flag: browser-use's IP block stops
# address *literals*, so despite its documentation it does not stop
# http://localhost:8080 (this app) or http://db:5432 (the control plane).
# Setting this explicitly replaces the default list entirely.
# QA_DENIED_HOSTS=localhost,db,metadata.google.internal,metadata.goog,metadata
#
# Per-project confinement is a column, not an env var: PUT a project's
# `allowed_domains` (see docs/api.md) to fence one team's suite to their own
# staging host.

# Safety ceiling on agent steps per run.
MAX_STEPS=60

# Hard wall-clock ceiling per run, in seconds (US-005). MAX_STEPS bounds steps,
# not time — this stops a stuck or rate-limited run (e.g. a throttled BYOK key
# retrying 429s) from squatting a browser slot. The run is killed and reported
# failed.
RUN_TIMEOUT_SECONDS=600

# How long a stopped run (US-047) is given to end itself before the hard kill.
# The agent is asked to stop between actions, which normally lands within a
# second or two and lets it finalize the recording and the report — the whole
# reason not to just SIGKILL it. An agent wedged inside an action never hears
# the request, so this is the ceiling before the tree is killed anyway. Generous
# rather than tight: pre-empting the graceful path throws away the evidence the
# stop was meant to preserve.
STOP_GRACE_SECONDS=10

# Port Express listens on (also mapped in docker-compose).
PORT=8080

# Render a PDF report for every finished run. Off while the report is being
# reworked: no renderer is spawned, /api/runs/<id>/report.pdf 404s, no download
# is offered anywhere in the app and notification mail carries no attachment.
# Set to 1/true/yes/on to switch it back on. A run's steps and diagnostics do
# not depend on this — they are read from runs/<id>/report_data.json, which is
# written either way.
REPORTS_ENABLED=

# Where this instance is reachable from outside, e.g. https://qa.example.com.
# Puts a working "View recording" link in the PDF report and a working run link
# in notification mail; the app serves both either way. With auth on it is also
# what magic-link sign-in redirects to, and what makes the session cookie
# Secure — so on a real deployment it must be the https:// URL, not the host.
PUBLIC_BASE_URL=

# --- Deployment behind the reverse proxy (US-007) ---
# Read by docker-compose.prod.yml, with one exception the app itself reads
# (TRUST_PROXY, below). A plain `docker compose up` self-host ignores the rest,
# so leaving this section alone changes nothing.

# The hostname Traefik serves this stack on. Must resolve to this box, and must
# agree with PUBLIC_BASE_URL above. No default: a stack with no hostname would
# come up unroutable and silently serve nothing.
#
# The app lives on a subdomain, not the apex: qassist.run is a landing page
# served outside this repo, so the box only ever answers for app., staging.
# and demo.
APP_HOST=app.qassist.run
# Where Let's Encrypt sends expiry warnings. Read by docker-compose.proxy.yml.
ACME_EMAIL=
# The image the stack runs. Production pins a released tag (US-032) so a deploy
# is a tag change and a rollback is the previous tag.
QASSIST_IMAGE=qassist:latest
# Host directory for run artifacts, per stack — two stacks on one box must not
# write into the same runs/ (US-038).
RUNS_DIR=./runs
# The same, for project fixtures (US-048). Kept separate from RUNS_DIR rather
# than nested inside it: artifact retention deletes uuid-named directories under
# the artifacts dir, and a fixture directory is named after its project — so a
# nested layout would delete a customer's uploads a week after they made them.
# The app refuses to boot if the two overlap.
FIXTURES_HOST_DIR=./fixtures
# X-Robots-Tag on every response. "all" is the public instance; a non-public
# hostname sets "noindex, nofollow" so it never reaches a search index.
ROBOTS_TAG=all
# How many proxies sit in front of the app — which decides whose address the
# per-IP guards count (the demo's mint throttle, the magic-link rate limit).
# Unlike the rest of this section this one is read by the APP, not by compose,
# so it is left commented: blank means trust nothing, which is right for a plain
# `docker compose up` publishing 8080 directly — there, believing
# X-Forwarded-For would let any caller claim any address.
#
# Uncomment it on any stack behind the Traefik overlay. Without it every request
# arrives from the proxy container, so a per-visitor limit silently becomes a
# limit on the whole deployment. "1" and "true" are different answers: 1 counts
# the address the proxy vouched for, true counts whatever the client wrote. A
# subnet list or Express's keywords (e.g. loopback) work for a longer chain.
# TRUST_PROXY=1

# Every run is recorded to runs/<runId>/recording.mp4. Set to 0 to turn
# recording off (saves ~0.1-0.2 vCPU per session, and unwatched runs then
# skip frame capture entirely).
QA_RECORD=1

# Project fixtures (US-048): files a project's tests may attach, uploaded in the
# Projects view. A run may only ever attach files belonging to its own test's
# project — that whitelist is what stops an agent being talked into reading
# something else off the container — so these caps are per project, not global.
# Per file, and per project in total. Bytes.
FIXTURE_MAX_BYTES=10485760
FIXTURE_PROJECT_QUOTA_BYTES=52428800

# Where a run's decrypted browser session (US-043) is written for the length of
# one spawn. Must NOT overlap FIXTURES_DIR or ARTIFACTS_DIR and the app refuses
# to boot if it does: under the first, the blob joins the whitelist browser-use
# gates `read_file` on — the agent could be argued into reading the credential
# into its own context; under the second it sits beside downloadable artifacts
# for ARTIFACT_RETENTION_DAYS. Emptied at boot, since a killed process leaves
# credentials nothing else will ever remove.
# SESSIONS_DIR=/data/sessions
# SESSION_MAX_BYTES=1048576

# How many days to keep a run's artifacts (runs/<runId>/: the PDF report and
# the mp4 recording, tens of MB per run). After this they are deleted and the
# run is marked in history as having had its artifacts removed — the verdict,
# timings and step count are kept forever either way. Swept at startup and
# every 6 hours. Set to 0 to keep artifacts until the disk fills.
ARTIFACT_RETENTION_DAYS=7

# Write a full HAR (runs/<runId>/network.har) for every run on this instance
# (US-044). Off by default, and a caller can ask for one per run with
# `"har": true` instead. The curated diagnostics summary — failed requests,
# console errors, uncaught exceptions — is always on and needs no setting; this
# is only the complete archive beside it.
#
# Two reasons it is opt-in. It is large, and it is the one artifact the agent's
# secret redaction does not reach: the browser writes it, so a secret in a query
# string lands in it verbatim. Headers and bodies are never recorded, and
# ARTIFACT_RETENTION_DAYS prunes it with everything else in runs/<runId>/.
# CAPTURE_HAR=1

# Email notifications (US-012). Both of the next two must be set or the
# feature is simply off: prefs are still stored and editable in the UI, and
# nothing is ever sent. Get a key at resend.com; MAIL_FROM has to be an
# address on a domain you have verified there, or Resend rejects the send.
RESEND_API_KEY=
# A bare address avoids the quoting difference between docker compose's
# env_file and node --env-file; "QAssist <qa@example.com>" works too if you
# want a display name, but quote it and check both paths still read it.
MAIL_FROM=qa@example.com
# Dev only: log every message (sign-in links, reports) to the server console
# instead of sending via Resend, so the auth/email flow is testable locally
# without an account. Counts as "mail configured", so setting this alone lets
# multi-user auth boot. Never enable it in production — nothing is delivered.
# It prints the plain-text body only; to see the HTML one, leave this unset and
# point RESEND_API_URL at `npm run mail-preview` instead (server/).
MAIL_DEV_CONSOLE=

# Who hears about a run, when a project has no recipient list of its own.
# Comma-separated. Falls through to OPERATOR_EMAIL below if left blank.
NOTIFY_EMAILS=

# Default for tests that belong to no project: failure | always | never.
# "failure" means anything that is not a pass — failed, error, and runs that
# ended without a verdict. Projects carry their own mode and ignore this.
NOTIFY_MODE=failure

# Signs the unsubscribe links so they need no API token. Defaults to
# WORKER_API_TOKEN, and to a random value per boot if that is blank too —
# which invalidates every link already mailed on restart. Set it if you care
# that yesterday's unsubscribe link still works: openssl rand -hex 32
NOTIFY_SECRET=

# The account row the app seeds on first boot, and the last-resort recipient
# when neither a project nor NOTIFY_EMAILS names anyone. The default is not a
# real mailbox, so set this if you want that fallback to reach you. With auth
# on (below), this is also the address that logs in as the pre-auth operator —
# request a link for it to reach everything created before auth existed.
OPERATOR_EMAIL=

# Multi-user auth (US-021). Off by default: leave AUTH_ENABLED blank and the
# app keeps its single-token behaviour (WORKER_API_TOKEN above, or open). Set
# it and the app serves magic-link login instead — and refuses to start unless
# all three of these are present: the control plane (DATABASE_URL), a mail
# sender (RESEND_API_KEY + MAIL_FROM), and SESSION_SECRET. With auth on, the
# shared WORKER_API_TOKEN stops working — each user creates their own API keys
# in the UI, and login links need PUBLIC_BASE_URL to point at a real domain.
AUTH_ENABLED=
# Signs the session cookies. No default on purpose: a blank one would sign
# everyone out on restart, and a shared one would forge sessions across
# instances. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Demo sandbox (US-036). AUTH_MODE=demo makes the whole deployment a per-visitor
# sandbox: each visitor is silently provisioned a fresh, short-lived user seeded
# with fake data, and every run is a replay of a checked-in fixture (no Python,
# no queue slot, no LLM call). Needs the control plane + SESSION_SECRET (above);
# needs no mail sender. Any other value leaves self-host and the magic-link app
# unchanged. A reaper deletes tenants past DEMO_TTL. Total live tenants are
# capped; tenant creation is rate-limited per IP.
# AUTH_MODE=demo
# DEMO_TTL_SECONDS=3600
# DEMO_MAX_TENANTS=200
# DEMO_IP_MAX=5
# DEMO_IP_WINDOW_SECONDS=3600
# Fixtures are checked-in directories under demo/<slug>/ (DEMO_DIR overrides).
# DEMO_SPEED>1 replays faster than recorded. DEMO_CTA_URL is where the sandbox's
# signup button points.
# DEMO_DIR=
# DEMO_SPEED=1
DEMO_CTA_URL=https://qassist.run

# Postgres control plane (saved tests, suites, run history). You normally
# don't set this: docker compose wires the app to its own db service, and
# `npm run dev` auto-starts that db and defaults to it on localhost:5433.
# Set it only to point at a different Postgres (shell env, not this file —
# the dev script's default wins over .env):
#   DATABASE_URL=postgres://user:pass@host:5432/qassist npm run dev

# Subscription billing (US-022). All three blank — the self-host default — is
# billing entirely off: no billing UI, no gating, every run free. Self-host is
# always free, so the switch is the absence of config rather than a flag.
# Setting them also needs PUBLIC_BASE_URL (Stripe sends the customer back
# there), the control plane, and AUTH_ENABLED: billing charges *users*, so a
# single-token or open instance is never gated. Missing any one leaves the
# instance byte-for-byte free. LLM tokens stay BYOK on every tier — a
# subscription pays for hosting, not for the model.
# STRIPE_SECRET_KEY=sk_live_…
# STRIPE_WEBHOOK_SECRET=whsec_…       (the endpoint's signing secret)
# STRIPE_PRICE_ID=price_…             (one recurring price = the one plan)
# Accounts that run without subscribing, comma-separated. Defaults to
# OPERATOR_EMAIL so the operator can smoke-test production without buying their
# own product; a self-hosting org lists its own staff here.
# BILLING_EXEMPT_EMAILS=

# The activation window (US-054): hours a paid account waits, after subscribing,
# while you add the capacity it just bought. A run is a real Chromium on a box
# you size by hand, so a subscription means "you may run once this instance has
# room for you" — said before they pay, and with a stated deadline.
#
# Unset or 0 = OFF, and off is the default: no fourth onboarding step, no gate,
# nothing read. An instance that already charges does not acquire a hold on its
# next customer because it was upgraded. Only meaningful with STRIPE_* set.
#
# Turning it off later releases everyone currently in the window — you never
# have to work through a backlog by hand. So if you have since bought a box big
# enough to stop rationing capacity, delete this line and restart.
#
# When it is on:  npm run activate                 lists who is waiting
#                 npm run activate -- <email>      gives one account its capacity
# You are mailed (OPERATOR_EMAIL) when someone starts waiting; they are mailed
# when you activate them. Nothing ever auto-activates at the deadline — that
# would hand a customer a box nobody upgraded.
# ACTIVATION_SLA_HOURS=24
