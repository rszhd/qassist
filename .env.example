# Copy to .env and fill in. Never commit the real .env.

# Shared secret every API/WS caller must send as `Authorization: Bearer <token>`.
# Optional for local single-user use: leave it blank and no token is required
# (the UI's token box can stay empty). Set one before exposing the port —
# generate with: openssl rand -hex 32
WORKER_API_TOKEN=

# OpenAI drives the browser agent. This is the one value you must supply;
# without it the app starts but refuses to run tests.
OPENAI_API_KEY=sk-...
BROWSER_USE_MODEL=gpt-4.1

# Concurrency cap — the real throttle for this box.
# Rule of thumb: floor((RAM_GB - 1.5) / 1). For 7.6 GB -> 4-5.
MAX_CONCURRENT_SESSIONS=4

# Safety ceiling on agent steps per run.
MAX_STEPS=60

# Port Express listens on (also mapped in docker-compose).
PORT=8080

# Where this instance is reachable from outside, e.g. https://qa.example.com.
# Only used to put a working "View recording" link in the PDF report; the app
# serves the recording either way.
PUBLIC_BASE_URL=

# Every run is recorded to runs/<runId>/recording.mp4. Set to 0 to turn
# recording off (saves ~0.1-0.2 vCPU per session, and unwatched runs then
# skip frame capture entirely).
QA_RECORD=1

# How many days to keep a run's artifacts (runs/<runId>/: the PDF report and
# the mp4 recording, tens of MB per run). After this they are deleted and the
# run is marked in history as having had its artifacts removed — the verdict,
# timings and step count are kept forever either way. Swept at startup and
# every 6 hours. Set to 0 to keep artifacts until the disk fills.
ARTIFACT_RETENTION_DAYS=7

# Email notifications (US-012). Both of the next two must be set or the
# feature is simply off: prefs are still stored and editable in the UI, and
# nothing is ever sent. Get a key at resend.com; MAIL_FROM has to be an
# address on a domain you have verified there, or Resend rejects the send.
RESEND_API_KEY=
# A bare address avoids the quoting difference between docker compose's
# env_file and node --env-file; "QAssist <qa@example.com>" works too if you
# want a display name, but quote it and check both paths still read it.
MAIL_FROM=qa@example.com
# Dev only: log every message (sign-in links, reports) to the server console
# instead of sending via Resend, so the auth/email flow is testable locally
# without an account. Counts as "mail configured", so setting this alone lets
# multi-user auth boot. Never enable it in production — nothing is delivered.
MAIL_DEV_CONSOLE=

# Who hears about a run, when a project has no recipient list of its own.
# Comma-separated. Falls through to OPERATOR_EMAIL below if left blank.
NOTIFY_EMAILS=

# Default for tests that belong to no project: failure | always | never.
# "failure" means anything that is not a pass — failed, error, and runs that
# ended without a verdict. Projects carry their own mode and ignore this.
NOTIFY_MODE=failure

# Signs the unsubscribe links so they need no API token. Defaults to
# WORKER_API_TOKEN, and to a random value per boot if that is blank too —
# which invalidates every link already mailed on restart. Set it if you care
# that yesterday's unsubscribe link still works: openssl rand -hex 32
NOTIFY_SECRET=

# The account row the app seeds on first boot, and the last-resort recipient
# when neither a project nor NOTIFY_EMAILS names anyone. The default is not a
# real mailbox, so set this if you want that fallback to reach you. With auth
# on (below), this is also the address that logs in as the pre-auth operator —
# request a link for it to reach everything created before auth existed.
OPERATOR_EMAIL=

# Multi-user auth (US-021). Off by default: leave AUTH_ENABLED blank and the
# app keeps its single-token behaviour (WORKER_API_TOKEN above, or open). Set
# it and the app serves magic-link login instead — and refuses to start unless
# all three of these are present: the control plane (DATABASE_URL), a mail
# sender (RESEND_API_KEY + MAIL_FROM), and SESSION_SECRET. With auth on, the
# shared WORKER_API_TOKEN stops working — each user creates their own API keys
# in the UI, and login links need PUBLIC_BASE_URL to point at a real domain.
AUTH_ENABLED=
# Signs the session cookies. No default on purpose: a blank one would sign
# everyone out on restart, and a shared one would forge sessions across
# instances. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Live demo replay (US-033). Off by default: leave DEMO_MODE blank and there is
# no demo route, no /ws?demo branch and no unauthenticated surface at all. Set
# it and the app serves a canned run at /demo — a recorded event log played back
# over the live stage, costing no browser session, queue slot or LLM call.
# Fixtures are checked-in directories under demo/<slug>/ (DEMO_DIR overrides the
# location). DEMO_SPEED>1 plays faster than recorded (the UI says "condensed").
# DEMO_CTA_URL is where the end-of-replay signup button points when the instance
# has no login of its own; with auth on it links to the app's own login instead.
DEMO_MODE=
# DEMO_DIR=
# DEMO_SPEED=1
DEMO_CTA_URL=https://qassist.run

# Postgres control plane (saved tests, suites, run history). You normally
# don't set this: docker compose wires the app to its own db service, and
# `npm run dev` auto-starts that db and defaults to it on localhost:5433.
# Set it only to point at a different Postgres (shell env, not this file —
# the dev script's default wins over .env):
#   DATABASE_URL=postgres://user:pass@host:5432/qassist npm run dev
