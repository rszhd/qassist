node_modules/
dist/
# VitePress's build cache for manual/ (its dist/ is covered above). Anchored,
# because a pattern with a slash in it is — an unanchored `cache/` would sweep
# up anything anyone ever names that.
manual/.vitepress/cache/
# The builder's publish stamp, if manual/publish.sh is ever run against a
# working tree rather than the container's clone.
.publish-stamp
.venv/
.env
# .env.staging and any other per-stack env file (US-038) — same rule as .env,
# and .env.staging.example is what is tracked instead.
.env.*
!.env*.example
runs/
# Anchored: server/test/fixtures/ is tracked and must not be swept up by this.
/fixtures/
# US-043: a run's decrypted session blob, for the length of one spawn.
/sessions/
# A second stack on the same box points RUNS_DIR at its own artifact directory,
# and FIXTURES_HOST_DIR at its own fixture directory.
runs-*/
fixtures-*/
*.log
# gitleaks --report-path output (US-031); the scan itself is configured by the
# tracked .gitleaks.toml.
.gitleaks-report.json
.DS_Store
__pycache__/
.pytest_cache/
mutants/
