node_modules/
dist/
.venv/
.env
# .env.staging and any other per-stack env file (US-038) — same rule as .env,
# and .env.staging.example is what is tracked instead.
.env.*
!.env*.example
runs/
# A second stack on the same box points RUNS_DIR at its own artifact directory.
runs-*/
*.log
# gitleaks --report-path output (US-031); the scan itself is configured by the
# tracked .gitleaks.toml.
.gitleaks-report.json
.DS_Store
__pycache__/
.pytest_cache/
mutants/
