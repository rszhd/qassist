# The docs stack (US-070) — copy to .env.docs and fill in.
#
#   docker compose -p qassist-docs -f docker-compose.docs.yml \
#     --env-file .env.docs up -d
#
# Unlike the other per-stack env files this one is NOT a diff from .env: the
# docs stack shares nothing with the app. No app, no Postgres, no mail, no
# Stripe, no token — it is nginx serving a directory, and a builder that fills
# that directory from `dev`. If a value you are about to add here is also in
# .env, that is the signal the docs site is turning into a second app, which is
# the thing docs/deploy/docs-site.md says it must not become.
#
# Everything below has a working default except DOCS_HOST.

# The hostname Traefik serves the manual on. Must resolve to this box. No
# default: a stack with no hostname comes up unroutable and silently serves
# nothing.
DOCS_HOST=docs.qassist.run

# What the builder clones and follows. Public over https and read-only — the
# builder has no credential and needs none, which is most of why this stack can
# be trusted to run unattended.
DOCS_REPO=https://github.com/rszhd/qassist.git

# The branch it publishes. `dev` is the point: a typo fix is live within one
# poll, with no CI run, no image build and no promotion.
#
# The cost, stated: a half-written page pushed to `dev` is a public page. That
# is acceptable for prose. If it ever stops being acceptable, the escape hatch
# is to point this at a `docs` ref and force-push to it the way `preview` works
# — no other change.
DOCS_BRANCH=dev

# How often the builder asks GitHub whether manual/ moved. A fetch of a shallow
# clone is a few KB, and a poll that finds nothing new does nothing at all.
DOCS_POLL_SECONDS=120

# X-Robots-Tag on every response. The manual exists to be the one link you send
# someone and the one page a search engine indexes, so "all" — unlike staging.
# A fork serving its own copy sets "noindex, nofollow".
ROBOTS_TAG=all
